<?xml version="1.0" encoding="UTF-8"?>
<gpx xmlns="http://www.topografix.com/GPX/1/1" version="1.1" creator="VitaBandet composite">
  <metadata>
    <name>Vita Bandet 2028 (composite)</name>
    <desc>Composite route for Vita Bandet 2028 — six trksegs, one per Section. Sources: Lotta &amp; Björn (S1 Grövelsjön→Storlien + S2 Storlien→Gäddede), Kalle (S3 Gäddede→Klimpfjäll) + lapland-trail-summer.gpx (S3 Klimpfjäll→Hemavan), Mårten (S4 Hemavan→Kvikkjokk), 2028-plan-kvikkjokk-abisko.gpx (S5 + S5b — Padjelanta-west via Ritsem and KL via Sälka), 2028-plan-abisko-paltsa.gpx (S6 — Nordkalottleden Abisko→Pältsa).</desc>
  </metadata>
